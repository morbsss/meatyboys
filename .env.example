# Template - copy to .env (local dev) or .env.production (VM)
# Never commit a file that contains real secrets.

# ── LOCAL DEVELOPMENT ─────────────────────────────────────────────────────────
SECRET_KEY=dev-secret-key-change-in-production
DEBUG=true
HOST=127.0.0.1
PORT=5000

# ── PRODUCTION (VM) ───────────────────────────────────────────────────────────
# SECRET_KEY=<generate: python -c "import secrets; print(secrets.token_hex(32))">
# DEBUG=false
# HOST=127.0.0.1    # bind loopback only - nginx fronts the public port 80
# PORT=5000         # internal gunicorn port, proxied by nginx

# ── Analytics pipeline (db_modelling/) ────────────────────────────────────────
# FRD_EMAIL=your@email.com
# FRD_PASSWORD=yourpassword
# FRD_LEAGUE_ID=fa3e96be-1307-4bd3-a2df-b3e40015a890
# FRD_SEASON_ID=bb0f57e5-84e9-48c4-a3cb-b3cf015e1a84
# CURRENT_SEASON=2026
